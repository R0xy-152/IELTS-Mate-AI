# Copy this file to `.env` and fill in your values.
# .env is git-ignored — never commit your real key.

# ---- Required to run the server (NOT required to run tests) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional ----

# Override the Gemini model. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Paid image model for AI image generation. Default: gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Comma-separated frontend origins allowed to call this API from browsers.
# Example: https://your-personal-site.com,https://www.your-personal-site.com
# CORS_ORIGINS=

# Demo protection: each IP can generate this many AI images per day.
IMAGE_DAILY_LIMIT_PER_IP=1

# Set a private random string in production so stored IP hashes cannot be guessed easily.
# RATE_LIMIT_SALT=

# Set this only if your network needs a proxy to reach Google APIs.
# Example for Clash Verge / mihomo on Windows: http://127.0.0.1:7897
# HTTP_PROXY_URL=

# SQLAlchemy database URL. Default is a local SQLite file.
# DATABASE_URL=sqlite:///./ielts_mate.db

# Optional: disable the public image fallback if you only want Gemini/local fallback.
# PUBLIC_IMAGE_API_ENABLED=true

# Optional timeouts/retries.
# GEMINI_TIMEOUT_SECONDS=12
# GEMINI_RETRIES=2
# IMAGE_TIMEOUT_SECONDS=20

# Keep false in production unless actively debugging.
# DEBUG=false
